<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:handlers="clr-namespace:ShopApp.Handlers"
    xmlns:vm="clr-namespace:ShopApp.ViewModels"
    x:Class="ShopApp.Views.CategoriesPage"
    Title="CategoriesPage">

    <ContentPage.BindingContext>
        <vm:CategoriesViewModel/>
    </ContentPage.BindingContext>

    <Shell.SearchHandler>
        <handlers:CategoriaBusquedaHandler
            Placeholder="Buscar Categorias"
            DisplayMemberName="Nombre"
            ShowsResults="True"/>
    </Shell.SearchHandler>

    <VerticalStackLayout Padding="15" Spacing="10">

        <Label
            Text="Categorias"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

        <CollectionView
            ItemsSource="{Binding Categories}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Button
                        Text="{Binding Nombre}"
                        Margin="0,5"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=SeleccionarCategoriaCommand}"
                        CommandParameter="{Binding .}"/>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
