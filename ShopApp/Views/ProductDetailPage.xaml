<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShopApp.ViewModels"
    x:Class="ShopApp.Views.ProductDetailPage"
    Title="ProductDetailPage">

    <ContentPage.BindingContext>
        <vm:ProductDetailViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>

        <VerticalStackLayout
            Padding="15"
            Spacing="10">

            <Label
                Text="Mas Información"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>

            <Label
                Text="{Binding Nombre}"
                FontAttributes="Bold"
                Margin="0,0,0,5"/>

            <Label
                Text="{Binding Descripcion}"
                FontAttributes="Bold"
                Margin="0,0,0,5"/>

            <Label
                Text="{Binding Precio}"
                FontAttributes="Bold"
                Margin="0,0,0,5"/>

            <Image
                Source="{Binding Imagen}"
                WidthRequest="128"
                Margin="18"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
