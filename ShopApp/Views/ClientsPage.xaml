<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:handlers="clr-namespace:ShopApp.Handlers"
    xmlns:vm="clr-namespace:ShopApp.ViewModels"
    x:Class="ShopApp.Views.ClientsPage"
    Title="ClientsPage">

    <ContentPage.BindingContext>
        <vm:ClientsViewModel/>
    </ContentPage.BindingContext>

    <Shell.SearchHandler>
        <handlers:ClienteBusquedaHandler
            Placeholder="Buscar Clientes"
            DisplayMemberName="Nombre"
            ShowsResults="True"/>
    </Shell.SearchHandler>

    <Grid
        Padding="15"
        RowDefinitions="Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Nuestros Clientes"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Clients}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Button
                        Text="{Binding Nombre}"
                        Margin="0,5"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientsViewModel}}, Path=SeleccionarClienteCommand}"
                        CommandParameter="{Binding .}"/>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
